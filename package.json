{
  "name": "studio-salitre-restaurant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "sanity dev --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "sanity build dist --yes",
    "deploy": "sanity deploy --yes",
    "schema:deploy": "sanity schemas deploy",
    "seed:audit": "node --experimental-strip-types scripts/seed-import.mjs audit",
    "seed:import": "node --experimental-strip-types scripts/seed-import.mjs import",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "sanity": "6.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0",
    "@sanity/client": "8.11.0",
    "@sanity/validation": "6.20.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0"
  },
  "packageManager": "npm@11.9.0"
}
